# Copy to .env and fill in. Never commit the real .env file.

# Which broker/execution module pair to use: "kite" (Zerodha, default) or
# "jainam" (XTS). Jainam is dry-run only -- see jainam/execution.py.
BROKER=kite

KITE_API_KEY=
KITE_API_SECRET=

# Jainam (XTS) credentials -- only needed if BROKER=jainam. See
# jainam/client.py's module docstring for the CONFIRM-BEFORE-LIVE caveats;
# JAINAM_BASE_URL must be Jainam's own production host from their API
# dashboard, NOT developers.symphonyfintech.in (Symphony's dev sandbox).
JAINAM_BASE_URL=
JAINAM_MARKET_API_KEY=
JAINAM_MARKET_API_SECRET=
JAINAM_INTERACTIVE_API_KEY=
JAINAM_INTERACTIVE_API_SECRET=
JAINAM_SOURCE=WEBAPI

# Safety switch. Keep true until you've reviewed the implementation report
# and explicitly decided to go live. BROKER=jainam cannot be set to false
# yet -- no real XTS order placement exists (config.py enforces this).
DRY_RUN=true

# Fixed lots per trade (Q1 default -- see report). Lot size itself is read
# live from Kite's instrument master, not hardcoded here.
POSITION_LOTS=1

# Opt-in hard-abort if the futures/spot basis at entry exceeds the warning
# threshold (Q7 default is OFF -- warn only, still trade as specified).
BASIS_HARD_ABORT=false

# Opt-in semi-automated daily login (OFF by default -- see report for the
# ToS / credential-security tradeoffs before setting these).
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=
