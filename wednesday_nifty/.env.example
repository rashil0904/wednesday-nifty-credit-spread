# Copy to .env and fill in. Never commit the real .env file.

# Jainam's own API host, from their API dashboard -- NOT
# developers.symphonyfintech.in, which is Symphony's own dev sandbox.
JAINAM_BASE_URL=

# XTS Market Data API credentials (quotes, candles, instrument lookup).
JAINAM_MARKET_API_KEY=
JAINAM_MARKET_API_SECRET=

# XTS Interactive API credentials (positions, orders).
JAINAM_INTERACTIVE_API_KEY=
JAINAM_INTERACTIVE_API_SECRET=

# Usually "WEBAPI" -- leave unset unless Jainam tells you otherwise.
JAINAM_SOURCE=WEBAPI

# Required before any order placement or net-position check will work
# (dry run doesn't need it). Find it on Jainam's API dashboard / your
# trading account.
JAINAM_CLIENT_ID=

# Our API login under that client (the userID the Interactive login
# returns, e.g. SNM3358A21). The client account is shared with other
# logins, so position checks count only trades placed by this login.
JAINAM_LOGIN_ID=

# Safety switch. Keep false until you've reviewed the open items in
# README.md and explicitly decided to go live.
JAINAM_LIVE=false

# Telegram notifications for every entry/exit/failure/skipped week.
# Leave both blank to disable notifications entirely.
#   1. Message @BotFather on Telegram -> /newbot -> get the bot token.
#   2. Add the bot to the chat/group you want notified, send it any message.
#   3. GET https://api.telegram.org/bot<TOKEN>/getUpdates -> "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared Jainam login-session cache across every strategy on this box
# -- XTS allows only one live token per API key, so without this, each
# project's own login silently kicks the others out. Matches
# broker/xts_client.py's hardcoded default; only needed here if you
# want a different shared path. Every project sharing this API key
# MUST point at the SAME path.
# JAINAM_SESSION_FILE=/root/shared_jainam/.jainam_session.json
